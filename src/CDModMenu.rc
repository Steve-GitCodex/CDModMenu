// Windows version resource for CDModMenu.asi.
//
// A PE that carries proper VERSIONINFO (company / product / version) scores as
// far more legitimate to AV ML classifiers than a metadata-less binary. The
// numeric version is pulled from core/version.h so there is one source of truth.
//
// If you add an application icon later, drop it next to this file and uncomment
// the IDI_ICON1 line below.

#include <windows.h>
#include "core/version.h"

// IDI_ICON1 ICON "CDModMenu.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    MOD_VERSION_MAJOR,MOD_VERSION_MINOR,MOD_VERSION_PATCH,0
 PRODUCTVERSION MOD_VERSION_MAJOR,MOD_VERSION_MINOR,MOD_VERSION_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"        // U.S. English, Unicode
        BEGIN
            VALUE "CompanyName",      MOD_NAME
            VALUE "FileDescription",  MOD_DESCRIPTION
            VALUE "FileVersion",      MOD_VERSION
            VALUE "InternalName",     MOD_FILENAME
            VALUE "OriginalFilename", MOD_FILENAME
            VALUE "ProductName",      MOD_NAME
            VALUE "ProductVersion",   MOD_VERSION
            VALUE "LegalCopyright",   "Based on Trinity (C) 2026 XeTrinityz, MIT"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
